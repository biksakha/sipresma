# Aplikasi ini berjalan mandiri (Standalone SPA) di Vercel App dan GitHub.
# Seluruh koneksi ke Firebase & Supabase telah diputuskan sehingga bebas kuota (No Quota Limit).
# Database tersimpan secara persisten pada browser lokal dengan fitur Cadangkan & Pulihkan (JSON).

# APP_URL: URL aplikasi saat di-deploy (otomatis diset oleh Vercel atau Cloud Run).
APP_URL="https://sipresma-man4kediri.vercel.app"

# GEMINI_API_KEY (Opsional jika menggunakan fitur asisten AI):
GEMINI_API_KEY=""
