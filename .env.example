# VITE_FIREBASE_APP_ID="1:858672719653:web:22a6caa18d62de2c0bdccc"
# VITE_FIREBASE_API_KEY="AIzaSyDRqaPVZkqFrmaxuo3iCp7uPXo_6seZGKk"
# VITE_FIREBASE_AUTH_DOMAIN="jovial-citron-msjh2.firebaseapp.com"
# VITE_FIREBASE_DATABASE_ID="ai-studio-sipresmapresensi-839a9f3e-c993-4ff5-983b-75c7dfe22d09"
# VITE_FIREBASE_STORAGE_BUCKET="jovial-citron-msjh2.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="858672719653"
